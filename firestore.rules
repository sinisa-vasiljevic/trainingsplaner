rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function master() { return signedIn() && request.auth.uid == '6qH3sJiqGQaCtO943YHaTZQe7ov2'; }
    function activeUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true; }
    match /invites/{code} {
      allow get: if true;
      allow list, create, delete: if master();
      allow update: if master() || (
        signedIn()
        && resource.data.active == true
        && resource.data.used == false
        && resource.data.email == request.auth.token.email
        && request.resource.data.active == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','used','usedAt','usedBy'])
      );
    }
    match /users/{uid} {
      allow read: if master() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','active','inviteCode','createdAt'])
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email;
      allow update, delete: if master();
      match /pushTokens/{tokenId} {
        allow read: if master() || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }
    match /{document=**} {
      allow read: if master() || activeUser();
      allow write: if master();
    }
  }
}
